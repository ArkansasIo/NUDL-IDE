module project;

schema RoadmapPhase {
    id: string required;
    name: string required;
    status: string required;
    goal: string required;
}

fn phase(id: string, name: string, status: string, goal: string) -> RoadmapPhase {
    return RoadmapPhase { id: id, name: name, status: status, goal: goal };
}

fn main() -> i64 {
    let current = phase("0.3", "Foundation", "active", "Bootstrap compiler and language specification");
    print(current.name);
    return 0;
}