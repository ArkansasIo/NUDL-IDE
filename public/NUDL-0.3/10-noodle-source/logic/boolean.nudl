module logic.boolean;

fn logical_not(value: bool) -> bool {
    return !value;
}

fn logical_and(a: bool, b: bool) -> bool {
    return a && b;
}

fn logical_or(a: bool, b: bool) -> bool {
    return a || b;
}

fn implication(a: bool, b: bool) -> bool {
    return !a || b;
}

fn equivalence(a: bool, b: bool) -> bool {
    return a == b;
}

fn main() -> i64 {
    print(implication(true, false));
    print(equivalence(true, true));
    return 0;
}
